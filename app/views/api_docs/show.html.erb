<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Library API docs</title>
    <%# Pinned to an exact version, so the page doesn't change under us. %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.33.1/swagger-ui.css">
  </head>
  <body>
    <div id="swagger-ui"></div>
    <script src="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.33.1/swagger-ui-bundle.js"></script>
    <script>
      window.ui = SwaggerUIBundle({
        url: "<%= api_docs_contract_path %>",
        dom_id: "#swagger-ui",
        // "Try it out" calls this server, whatever host and port it's reached on.
        requestInterceptor: (request) => {
          request.url = request.url.replace(/^https?:\/\/localhost:3000/, window.location.origin)
          return request
        }
      })
    </script>
  </body>
</html>
